rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check admin
    function isAdmin() {
      return request.auth != null && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Client Reservations: Allow public creation for appointment bookings, public lookup for ticket status, and full management
    match /reservations/{reservationId} {
      allow read: if true;
      allow create: if request.resource.data.name != null || request.resource.data.clientName != null;
      allow update, delete: if true;
    }

    // Live Walk-In Waitlist: Allow clients to view queue and register, and staff/owner to manage
    match /waitlist/{ticketId} {
      allow read, create, update, delete: if true;
    }

    // Shop Configuration & Waitlist status (open/closed, hours, announcements)
    match /shop_config/{configId} {
      allow read, write: if true;
    }

    // VIP Promo Club Signups (15% discount)
    match /vip_club/{docId} {
      allow read, write: if true;
    }

    // Barbers profiles and ratings
    match /barbers/{barberId} {
      allow read, write: if true;
    }

    // Client Reviews & Ratings
    match /reviews/{reviewId} {
      allow read, write: if true;
    }
    
    // User accounts
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }
  }
}

