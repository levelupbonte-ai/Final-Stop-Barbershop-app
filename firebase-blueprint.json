{
  "schema": {
    "reservations": {
      "path": "reservations/{reservationId}",
      "description": "User reservations for haircuts",
      "fields": {
        "userId": { "type": "string", "description": "Auth UID of the user" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "service": { "type": "string" },
        "date": { "type": "timestamp" },
        "time": { "type": "string" },
        "status": { "type": "string", "description": "Status of the reservation (pending, confirmed, cancelled)" },
        "createdAt": { "type": "timestamp" }
      },
      "access": {
        "read": "request.auth != null && (request.auth.uid == resource.data.userId || hasRole('admin'))",
        "create": "request.auth != null && request.auth.uid == request.resource.data.userId",
        "update": "hasRole('admin') || (request.auth != null && request.auth.uid == resource.data.userId && request.resource.data.userId == resource.data.userId)",
        "delete": "hasRole('admin')"
      }
    }
  },
  "roles": {
    "admin": {
      "description": "Barber shop owner/admin",
      "validation": "get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'"
    }
  }
}
